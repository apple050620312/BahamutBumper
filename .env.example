# Pterodactyl Variables
TZ=Asia/Taipei
BUMP_TIME=20:30
BAHAMUT_ACCOUNT=sangege01
BAHAMUT_MESSAGE=推
# 只有內容完全等於下列任一值的昨日回覆才可刪除；eee 用於第一次接手既有推文。
BAHAMUT_DELETE_MESSAGES=推,eee
BAHAMUT_TARGET_URL=https://forum.gamer.com.tw/C.php?bsn=18673&snA=205415
BAHAMUT_COOKIE_FILE=data/cookies.json
# 若還有其他「伺服招生」文章，逗號分隔列在此處，避免同一天在不同文章自推。
BAHAMUT_GUARD_URLS=
DATA_DIR=data
RUN_MISSED_ON_START=true
RETRY_MINUTES=10
MAX_RETRIES=3
HTTP_TIMEOUT_SECONDS=30
