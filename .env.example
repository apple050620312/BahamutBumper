# 複製成 .env，與 main.py 放在同一個資料夾。需要調整的項目再取消註解。
# 同一項若已由啟動環境設定，以啟動環境為準。

# 帳號清單。每個帳號在 JSON 裡綁定一篇文章。留空時使用下方的單帳號設定。
BAHAMUT_ACCOUNTS_FILE=data/accounts.json

# 執行資料所在的資料夾。預設的密碼檔、Cookie、Webhook 檔和狀態檔都放在這裡或其子資料夾。
# DATA_DIR=data

# 排程時區與時間
# TZ=Asia/Taipei
# BUMP_TIME=20:30
# 過了排程時間才啟動時，補執行一輪。
# RUN_MISSED_ON_START=true
# 每輪最多執行次數，包含第一次。兩次執行之間的等待時間以分鐘計。
# MAX_RETRIES=3
# RETRY_MINUTES=10

# 每篇文章使用的回覆文字
# BAHAMUT_MESSAGE=推
# 自訂可清理的舊回覆文字，以逗號分隔。未設定時只比對 BAHAMUT_MESSAGE 的完整文字。
# BAHAMUT_DELETE_MESSAGES=推

# 預設以密碼登入。設為 false 時使用已保存的 Cookie。
# 多帳號可在個別帳號的 JSON 設定中用 auto_mobile_login 覆寫。
# AUTO_MOBILE_LOGIN=true
# HTTP 請求逾時秒數，最少 5 秒。
# HTTP_TIMEOUT_SECONDS=30
# 日誌層級，例如 DEBUG、INFO、WARNING 或 ERROR。
# LOG_LEVEL=INFO

# Discord 通知。可在指定檔案放 Webhook URL，或直接設定 URL。
# 直接設定 URL 時優先使用該值。檔案預設位於 DATA_DIR 底下。
# DISCORD_WEBHOOK_FILE=data/discord_webhook.txt
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN
# 可填自己的純數字 ID，讓 Discord 在失敗通知中標註你。留空時會發送一般通知。
# DISCORD_ATTENTION_USER_ID=123456789012345678

# 單帳號模式。將 BAHAMUT_ACCOUNTS_FILE 留空，並明確填寫帳號與文章網址。
# BAHAMUT_ACCOUNT=your_account
# BAHAMUT_TARGET_URL=https://forum.gamer.com.tw/C.php?bsn=60&snA=12345
# 其他需要一併檢查的文章網址，以逗號分隔。多帳號請用各組的 guard_urls。
# BAHAMUT_GUARD_URLS=
# 登入檔案。預設位於 DATA_DIR 底下。多帳號請用各組的 password_file 和 cookie_file。
# BAHAMUT_PASSWORD_FILE=data/bahamut_password.txt
# BAHAMUT_COOKIE_FILE=data/cookies.json
