# Pterodactyl Variables
TZ=Asia/Taipei
BUMP_TIME=20:30
# 多帳號可填 data/accounts.json。每個帳號在該 JSON 中綁定一篇文章。
BAHAMUT_ACCOUNTS_FILE=
BAHAMUT_ACCOUNT=sangege01
BAHAMUT_MESSAGE=推
# 只有內容完全等於下列任一值的昨日回覆才可刪除；eee 用於第一次接手既有推文。
BAHAMUT_DELETE_MESSAGES=推,eee
BAHAMUT_TARGET_URL=https://forum.gamer.com.tw/C.php?bsn=18673&snA=205415
BAHAMUT_COOKIE_FILE=data/cookies.json
# API 無法使用時仍須驗證現有論壇 Cookie；設 false 則完全不使用帳密登入。
AUTO_MOBILE_LOGIN=true
BAHAMUT_PASSWORD_FILE=data/bahamut_password.txt
# 若還有其他「伺服招生」文章，逗號分隔列在此處，避免同一天在不同文章自推。
BAHAMUT_GUARD_URLS=
DATA_DIR=data
RUN_MISSED_ON_START=true
RETRY_MINUTES=10
MAX_RETRIES=3
HTTP_TIMEOUT_SECONDS=30
DISCORD_WEBHOOK_FILE=data/discord_webhook.txt
DISCORD_ATTENTION_USER_ID=523114942434639873
LOG_LEVEL=INFO
